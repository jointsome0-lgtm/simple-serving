# The picture card's parameters (docs/pictures.md, section 9), read by card/pictures/bootstrap.sh and
# simple_serving/pictures/card.py. No credentials, no quotes and no spaces. A change makes the card unprepared until
# bootstrap.sh runs again. The engine's pins are the copied image-manifest.env's (SOURCE): ComfyUI's revision, the
# torch wheels and the weights, each checked as simple-story-chat checks them, and the health check expects its
# COMFYUI_VERSION and TORCH_CU130_VERSION.

# What /v1/state names the lane's model.
MODEL_ALIAS=qwen-image-2.1
# Seconds from the start of the pair to the gateway's first ready. ComfyUI loads the weights at the first picture and
# not at its start, so this bounds the start alone. Provisional until the card test (section 15).
LOAD_DEADLINE_S=300

# The listeners, all on loopback: the gateway's public and control listeners, beside the text lane's 8090 and 8091,
# and ComfyUI's, the port its old start used.
PUBLIC_PORT=8094
CONTROL_PORT=8095
ENGINE_PORT=8188

# The engine as simple-story-chat's bot card runs it (its docs/gpu.md#bot-card), passed to the copied scripts as
# SIMPLE_CHAT_GPU_DIR and SIMPLE_CHAT_IMAGE_*: the install the old scripts use, Qwen-Image 2.1 alone, torch for CUDA 13
# in .venv-cu130, comfy-kitchen's Triton backend, and the rental's one card. bootstrap.sh refuses any other Qwen or
# torch line, which are the experiments'.
GPU_DIR=/workspace/simple-chat-gpu
IMAGE_QWEN=only
IMAGE_TORCH=cu130
IMAGE_TRITON=1
IMAGE_GPU=0

# The node classes a reader's graph may use (section 4), separated by commas: the bot's graphs as it draws them, with
# the saving node turned into a preview, its references and the kitchen's attention. No node that saves, and a
# LoadImage reads only the reader's own upload (section 5). A test holds it to simple_serving/pictures/config.py's.
READER_NODES=UNETLoader,CLIPLoader,VAELoader,CheckpointLoaderSimple,CLIPTextEncode,ConditioningZeroOut,TextEncodeQwenImage21,QwenImage21Cache,EmptyLatentImage,KSampler,VAEDecode,PreviewImage,ModelAttentionBackend,LoadImage,ImageScale
