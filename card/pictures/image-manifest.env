# Public, pinned inputs for the picture card, beside manifest.env for the language card. No credentials.
# Both scripts `source` this file under `set -euo pipefail`: a value holding a space has to be quoted, or bash runs
# its tail as a command and the script dies at line 1. local/image-workflow.test.ts sources it the same way.
# Reviewed 2026-09-21 against the CivitAI model API, the Hugging Face tree API and ComfyUI's own Krea 2 blueprint.
# Sizes are exact byte counts; every download is verified by size and SHA256 before it is used.

# ComfyUI release v0.37.0 (2026-09-20). Its `blueprints/Text to Image (Krea-2 Turbo).json` is where the node names,
# the text-encoder type and the file names below come from, so the pin and image-workflow.json move together.
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REVISION=73c9bad4d21e7addbe1d13bc92eee0f1431b017d
COMFYUI_VERSION=0.37.0
# The Qwen2 tokenizer both picture text encoders read, a directory of that revision. `npm run tokenizers` fetches its
# three files from raw.githubusercontent.com at COMFYUI_REVISION and refuses them unless they have these SHA-256s.
QWEN_TOKENIZER_PATH=comfy/text_encoders/qwen25_tokenizer
QWEN_TOKENIZER_VOCAB_SHA256=ca10d7e9fb3ed18575dd1e277a2579c16d108e32f27439684afa0e10b1440910
QWEN_TOKENIZER_MERGES_SHA256=8831e4f1a044471340f7c0a83d7bd71306a5b867e95fd870f74d0c5308a904d5
QWEN_TOKENIZER_CONFIG_SHA256=49292bd4a58a43382bf01311bc3ed7a151a7f16fe07d155e900ea1af281555db
# No third-party custom nodes: Krea 2, er_sde and the fp8 loaders are all in core, and image-serve.sh starts the
# server with --disable-all-custom-nodes so a stray clone in custom_nodes/ cannot change a measurement. The one
# exception is an opt-in test, Viggle's node below, which the server loads by its file name alone and only when asked.
COMFYUI_CUSTOM_NODES=none

# Torch for Blackwell (RTX 5090, sm_120). cu128 is the oldest wheel line that carries sm_120 kernels and it runs on
# the widest range of drivers, so it is the default, which the experiments keep. The versions are the newest triple
# published on the cu128 index on 2026-09-21.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
TORCH_VERSION=2.11.0+cu128
TORCHVISION_VERSION=0.26.0+cu128
TORCHAUDIO_VERSION=2.11.0+cu128
TORCH_ARCH=sm_120
# cu130, the bot's line (SIMPLE_CHAT_IMAGE_TORCH=cu130, docs/gpu.md#cu130), in a virtual environment of its own: the
# pinned ComfyUI turns comfy-kitchen's CUDA backend off on a torch built for CUDA below 13 (comfy/quant_ops.py:22-28).
# Read on the cu130 index on 2026-09-26: the same torch release as cu128's and the same triton, 3.6.0, so that the
# CUDA line and the kitchen's backend are what differs. The index's newest torch, 2.14.0+cu130, asks for triton 3.8,
# and no torchaudio there is newer than 2.11.0+cu130. It needs a driver for CUDA 13, which the rent filter asks of an
# offer.
TORCH_CU130_INDEX_URL=https://download.pytorch.org/whl/cu130
TORCH_CU130_VERSION=2.11.0+cu130
TORCHVISION_CU130_VERSION=0.26.0+cu130
TORCHAUDIO_CU130_VERSION=2.11.0+cu130
# cu130's four wheels by sha256, as the cu130 index listed them on 2026-09-27 for CPython 3.12 on manylinux x86_64,
# the Python of the rented image (local/rent-plan.ts `IMAGE`): image-bootstrap.sh installs them with pip's
# --require-hashes and --no-deps before anything else goes into .venv-cu130, and a file of another hash stops it. The
# index's triton 3.6.0 is a build other than PyPI's of the same version. What they pull (cuda-toolkit 13.0.2's NVIDIA
# libraries, cuDNN, cuSPARSELt, NCCL, NVSHMEM, cuda-bindings) and ComfyUI's requirements still go on by version, as
# cu128's torch does.
TORCH_CU130_SHA256=96911323dcfcd42028c7e8edde7bdf25bb187753234e8775f0f3f112e86a22db
TORCHVISION_CU130_SHA256=0f030a9bd8ada1a31b7111ea1589c1ecb5fa0884fee700a203e731b4cf378a98
TORCHAUDIO_CU130_SHA256=3fba988f4301fe13547fe5e99c76d9ae36a27e19ded82eeffed9d2456e12edef
TRITON_CU130_VERSION=3.6.0
TRITON_CU130_SHA256=6f5928e6d44c34a97bbe164cceddc0ef2007121c89ebcfba5415cf452de7ee9f

# Kreamania Variant 8, the fine-tune the tester asked for: CivitAI model 2729631, version 3292830, file 3184832.
# CivitAI's own metadata calls this file `SafeTensor/fp8`, but its labels are not trustworthy — the same version
# offers a 8167318440-byte file labelled `bf16` when bf16 of this transformer is 26283332608 bytes. Size and hash
# are the identity; the format label is a hint to check on the card.
# 12821743396 bytes is about half the bf16 transformer, so this is the diffusion model alone (UNETLoader), not a
# checkpoint carrying the encoder and VAE. Downloading it needs a CivitAI API token (an anonymous GET gets 401).
IMAGE_MODEL_NAME="Kreamania Variant 8"
CIVITAI_MODEL_ID=2729631
CIVITAI_VERSION_ID=3292830
CIVITAI_FILE_ID=3184832
IMAGE_MODEL_URL=https://civitai.com/api/download/models/3292830?fileId=3184832
IMAGE_MODEL_FILE=kreamania_variant8_fp8.safetensors
IMAGE_MODEL_SHA256=c9265985daf6b8316faf55ab7095b4a45d7252cde6408b1a92177c855e02721b
IMAGE_MODEL_BYTES=12821743396
IMAGE_MODEL_FORMAT=fp8-safetensors
# The version's trained word. Whether the prompt builder should carry it is a question for the first pictures.
IMAGE_MODEL_TRIGGER="Bradhamel art style"

# Text encoder and VAE. ComfyUI loads Krea 2 from three separate files, and these two are the ComfyUI-native
# repackagings from Comfy-Org/Krea-2 — the exact file names ComfyUI's own Krea 2 blueprint asks for, public, so the
# picture lane does not depend on a gated repository at three in the morning. The originals they were made from are
# pinned under OFFICIAL_ below.
IMAGE_ENCODER_REPO=Comfy-Org/Krea-2
IMAGE_ENCODER_REVISION=e5ea8b4dd7f38f348b138eb0fe29f92c0e367e96
IMAGE_ENCODER_PATH=text_encoders/qwen3vl_4b_fp8_scaled.safetensors
IMAGE_ENCODER_FILE=qwen3vl_4b_fp8_scaled.safetensors
IMAGE_ENCODER_SHA256=54bd5144df0bbc25dd6ccadfcb826b521445a1b06ae5a42570bdd2974ca87094
IMAGE_ENCODER_BYTES=5242467968
IMAGE_VAE_REPO=Comfy-Org/Krea-2
IMAGE_VAE_REVISION=e5ea8b4dd7f38f348b138eb0fe29f92c0e367e96
IMAGE_VAE_PATH=vae/qwen_image_vae.safetensors
IMAGE_VAE_FILE=qwen_image_vae.safetensors
IMAGE_VAE_SHA256=a70580f0213e67967ee9c95f05bb400e8fb08307e017a924bf3441223e023d1f
IMAGE_VAE_BYTES=253806246

# Official Krea 2 Turbo as the comparison checkpoint: the same fp8 class as Kreamania, so a slow or ugly picture
# separates "this fine-tune" from "this model on this card". SIMPLE_CHAT_IMAGE_TURBO=false skips its 13 GB.
IMAGE_TURBO_REPO=Comfy-Org/Krea-2
IMAGE_TURBO_REVISION=e5ea8b4dd7f38f348b138eb0fe29f92c0e367e96
IMAGE_TURBO_PATH=diffusion_models/krea2_turbo_fp8_scaled.safetensors
IMAGE_TURBO_FILE=krea2_turbo_fp8_scaled.safetensors
IMAGE_TURBO_SHA256=eb4dd8c612cfd10f64f25b057e6e6bbcb5737c94a7372177e456dbf7579502f1
IMAGE_TURBO_BYTES=13141730784

# Qwen-Image 2.1, the third comparison checkpoint, OFF by default: SIMPLE_CHAT_IMAGE_QWEN=true adds these three
# files, 17.28 GB, to the download. It is off because local/rent-plan.ts prices the session from the files a default
# run pulls and a test ties that constant to this manifest — an opt-in that is on by default is not an opt-in, it is
# a bill. Comfy-Org/Qwen-Image-2.1 is the ComfyUI-native repackaging, public and ungated; read 2026-09-21 from the
# Hugging Face tree API at the revision below, sizes and hashes from `lfs.sha256`.
# Licence: Qwen Research License (`license_name: qwen-research` on the repository), non-commercial; the owner
# accepted it on 2026-09-22 for as long as only the owner and the tester use the bot. See docs/illustrations-plan.md.
# int8_convrot, not bf16, for both the transformer and the text encoder. Three reasons, in the order they decide:
#   - ComfyUI's own two Qwen-Image-2.1 templates ship with exactly these two files as their widget values, so this is
#     the pairing upstream authored and ran; bf16 is the one we would be improvising with.
#   - one 32 GB card: bf16 is 14.23 + 17.53 + 0.68 = 32.4 GB of weights before a single activation, which does not
#     fit and would be paid for in offloading on every cell. int8 is 17.28 GB and leaves room for the encoder, the
#     reference latents of the edit path and a 1280x720 sample at once.
#   - the download is 17.28 GB against 32.4 GB, which at the 200 Mbit/s floor of image-bootstrap.sh is 12 minutes
#     against 22 of a time-boxed session.
# The w4a8 encoder (6.31 GB) would save three more, and is refused: the encoder is the part that reads the assembled
# prompt, and the prompt is what this lane measures. The two qwen3.5_9b "pe" files are prompt *enhancers* — they
# rewrite the request before it is drawn — and are refused for the same reason the Krea blueprint's rewriting branch
# was dropped: the judge grades the picture against `prompt_sent`, and an enhanced prompt is not that text. The
# text-to-image one is fetched only for the prompt arms probe, which judges against the scene and not the prompt sent
# (IMAGE_QWEN_PE_T2I below).
IMAGE_QWEN_NAME="Qwen-Image 2.1"
IMAGE_QWEN_REPO=Comfy-Org/Qwen-Image-2.1
IMAGE_QWEN_REVISION=ace0edeb3791a594ddfa36ed5f41a178a394e921
IMAGE_QWEN_MODEL_PATH=diffusion_models/qwen_image_2.1_int8_convrot.safetensors
IMAGE_QWEN_MODEL_FILE=qwen_image_2.1_int8_convrot.safetensors
IMAGE_QWEN_MODEL_SHA256=cb74113cb03faecd79611b01fd7fd642f0aa60d6f0b95086abee214d75eaa57d
IMAGE_QWEN_MODEL_BYTES=7256783064
IMAGE_QWEN_ENCODER_PATH=text_encoders/qwen3vl_8b_int8_convrot.safetensors
IMAGE_QWEN_ENCODER_FILE=qwen3vl_8b_int8_convrot.safetensors
IMAGE_QWEN_ENCODER_SHA256=8bfd0f6e12abf2d2d697ecc888e5e90b0d6741d6708f05799f53afa560452e8f
IMAGE_QWEN_ENCODER_BYTES=9350798360
IMAGE_QWEN_VAE_PATH=vae/qwen_image_2.1_vae_bf16.safetensors
IMAGE_QWEN_VAE_FILE=qwen_image_2.1_vae_bf16.safetensors
IMAGE_QWEN_VAE_SHA256=bb21f7473051e1ac368515dd3f2e15cd44d7a11748ee8823e1ddca3e4876b7c9
IMAGE_QWEN_VAE_BYTES=675509688
# Qwen-Image 2.1's text-to-image prompt enhancer, a Qwen3.5 9B in the same repository and revision, OFF by default:
# SIMPLE_CHAT_IMAGE_QWEN_PE=true, beside SIMPLE_CHAT_IMAGE_QWEN, adds this one file, 9.47 GB, for the prompt arms probe
# (docs/action-experiment.md#prompt-arms), which rewrites a frame's prompt with it through ComfyUI's TextGenerate on the
# picture card and judges the picture against the scene. The bot never loads it. Read 2026-09-28 from the tree API at
# the revision above, the hash from `lfs.oid`; the image-to-image sibling (…_pe_i2i…, same size) is not fetched. Its
# model card, Qwen/Qwen-Image-2.1-PE-T2I, ships the system prompt the probe fetches and checks itself.
IMAGE_QWEN_PE_T2I_PATH=text_encoders/qwen3.5_9b_qwen_image_2.1_pe_t2i.int8_convrot.safetensors
IMAGE_QWEN_PE_T2I_FILE=qwen3.5_9b_qwen_image_2.1_pe_t2i.int8_convrot.safetensors
IMAGE_QWEN_PE_T2I_SHA256=9182abae56fe05459840a86d22abd21f972061c92fce032630af680c8c5178d3
IMAGE_QWEN_PE_T2I_BYTES=9471072252
# Two graphs, because one run has one workflow: the text-to-image one draws the same frames as Krea for the blind
# comparison, the edit one takes reference portraits for the identity test. Both are converted from the official
# templates (Comfy-Org/workflow_templates, image_qwen_image_2_1_t2i.json and image_qwen_image_2_1_image_edit.json,
# read 2026-09-21) and keep their sampler, scheduler, steps and cfg. Checked against the pinned ComfyUI revision:
# `TextEncodeQwenImage21` and `QwenImage21Cache` are in core (comfy_extras/nodes_qwen.py), `qwen_image` is a
# CLIPLoader type (nodes.py) which dispatches a Qwen3-VL-8B encoder to comfy/text_encoders/qwen_image21.py (sd.py),
# and the model class carries shift 0.69 (comfy/supported_models.py), which is why neither graph sets a shift.
# So the pin stands as it is and Krea keeps working; no re-pin was needed for Qwen.
# Where the edit graph departs from its template, and why, because it is the one place it does: the template feeds
# the sampler from the encode node's own latent output, through a switch whose other branch is a free-size canvas.
# We sample from an `EmptyLatentImage`, because local/image-batch.ts requires the sampler's latent to come from a
# node with a width and a height — and we pin it to 1280x704, which is exactly what that output would be: at the
# template's `resolution: 0` the node keeps each reference at its own size rounded to a multiple of 32, and a
# 1280x720 portrait rounds to 1280x704. The relationship the node asks for ("any other size shifts the edit") is
# kept; only the wire is different. The frame is 16 rows shorter than the text-to-image one for that reason.
IMAGE_QWEN_WORKFLOW=image-workflow-qwen.json
IMAGE_QWEN_EDIT_WORKFLOW=image-workflow-qwen-edit.json

# Viggle's few-step LoRA for Qwen-Image 2.1, a test the owner allowed on 2026-09-26 («в качестве теста можно»,
# docs/action-experiment.md#backend), OFF by default like Qwen and for the same reason: SIMPLE_CHAT_IMAGE_VIGGLE=true
# adds the LoRA to models/loras and its two nodes, one Python file, to custom_nodes, and image-serve.sh then loads that
# file by name beside --disable-all-custom-nodes (docs/gpu.md#viggle). The r128 LoRA, the one the repository's own
# workflows load (0.68 GB; r256 is 1.4), in diffusers' key format: ViggleTurboLora applies it beside the weights,
# y = Wx + BAx, where ComfyUI's own LoRA loaders would merge it into the int8 weights. ViggleTurboSigmas is the
# six-step schedule it was distilled for. Public, no token. Read 2026-09-26 at the revision below; the node is a plain
# file, and its SHA-256 is that of its bytes at that revision.
IMAGE_VIGGLE_REPO=Viggle/Qwen-Image-2.1-viggle-turbo
IMAGE_VIGGLE_REVISION=bb26a0f38e5fe6c124aaccc9187a87eed5d9ed13
IMAGE_VIGGLE_LORA_PATH=Qwen-Image-2.1-viggle-turbo-v0.2.1-6step-lora-r128.safetensors
IMAGE_VIGGLE_LORA_FILE=Qwen-Image-2.1-viggle-turbo-v0.2.1-6step-lora-r128.safetensors
IMAGE_VIGGLE_LORA_SHA256=bafb91d0047df3f9b8a5a850b0c967f051164314d8aad778dfa34d9c24ec345b
IMAGE_VIGGLE_LORA_BYTES=679604800
IMAGE_VIGGLE_NODE_PATH=comfyui/viggle_turbo.py
IMAGE_VIGGLE_NODE_FILE=viggle_turbo.py
IMAGE_VIGGLE_NODE_SHA256=017911bb7d9c855c6ea6854adeeeea1aed576ca1c9cb487376419f5bae14e93d
IMAGE_VIGGLE_NODE_BYTES=5469

# The gated originals in krea/Krea-2-Turbo (licence: krea.ai community licence, LICENSE.pdf in the repo). They are
# in diffusers layout, which ComfyUI's loaders are not known to accept, so they are the provenance record and the
# fallback, not the default. SIMPLE_CHAT_IMAGE_SOURCE=official downloads these instead; it needs a Hugging Face
# token with access to the gate, which image-bootstrap.sh reads from stdin or the environment and never writes down.
# Their SHA256 says `unknown` because Hugging Face hides the LFS hashes of a gated repository from a caller who has
# not accepted the gate — the sizes come through, the hashes come back as 64 asterisks. Read the tree with the token
# (`/api/models/krea/Krea-2-Turbo/tree/<revision>?recursive=true`, field `lfs.oid`) and paste the three values in
# before using this source; image-bootstrap.sh refuses to download an entry whose hash is still `unknown`.
OFFICIAL_REPO=krea/Krea-2-Turbo
OFFICIAL_REVISION=98e0fe118d17c9e3547fbb2e25acdbae2cadf7c7
OFFICIAL_ENCODER_PATH=text_encoder/model.safetensors
OFFICIAL_ENCODER_FILE=krea2_text_encoder_qwen3vl_4b_bf16.safetensors
OFFICIAL_ENCODER_SHA256=unknown
OFFICIAL_ENCODER_BYTES=8875715136
OFFICIAL_VAE_PATH=vae/diffusion_pytorch_model.safetensors
OFFICIAL_VAE_FILE=krea2_vae_diffusers.safetensors
OFFICIAL_VAE_SHA256=unknown
OFFICIAL_VAE_BYTES=507591892
OFFICIAL_TURBO_PATH=turbo.safetensors
OFFICIAL_TURBO_FILE=krea2_turbo_bf16.safetensors
OFFICIAL_TURBO_SHA256=unknown
OFFICIAL_TURBO_BYTES=26283332608

# The frozen text-to-image graph the bot posts to /prompt. Node names and widget names come from the pinned ComfyUI.
# Read against that source: the nodes and input names (nodes.py), `er_sde` and `simple` (comfy/samplers.py), the
# `krea2` encoder type and its Qwen3-VL-4B tap (comfy/text_encoders/krea2.py), the three model folders
# (folder_paths.py), and the whole loader shape, which is ComfyUI's own Krea 2 blueprint minus the LoRA and the
# prompt-rewriting branch. The blueprint also sets 8 steps and cfg 1.0 (its sampler is euler; er_sde is the tester's).
# Not verified without a card, in the order they would bite: that the CivitAI fine-tune loads through UNETLoader with
# weight_dtype `default` (if it is plain fp8 rather than fp8_scaled, try `fp8_e4m3fn`); that 1280x720 is a resolution
# this Turbo distillation is happy at (the model card claims 1k-2k); that shift 1.15 built into the Krea2 model class
# is all the timestep shift the fine-tune wants; and that the fine-tune keeps the official encoder and VAE at all.
# The file here is the template: the loaders name the `comfy` files. image-bootstrap.sh renders it into $gpu_dir
# with the names the chosen source actually installed, and that rendered copy is what the bot posts.
IMAGE_WORKFLOW=image-workflow.json
