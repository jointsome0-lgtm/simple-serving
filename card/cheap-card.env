# The cheap card's manifest (docs/speed.md, the runbook's "The cheap card"): manifest.env with Google's Gemma 4 E2B
# in place of the heretic and E2B's assistant in place of the 31B's, the rest unchanged, so that the engine starts of
# the cheap card's step 4 run the card's own arguments. Only for that card: its checkout copies this file over
# card/manifest.env, and bootstrap.sh prepares the card anew. E2B is bfloat16 (one file of 10.2 GB), not NVFP4, so
# the FP4 kernels are judged by the microbenchmark alone; the tokenizer and template are E2B's own.
# Pinned on 2026-09-27 at these revisions from the Hugging Face API's file metadata, the weights never downloaded: a
# file kept in LFS (the weights, tokenizer.json) is pinned by its LFS oid, and a small file by the sha256 of its
# content, fetched alone and checked against the tree's git blob sha1. The model and tokenizer pins are those of the
# rehearsal of 2026-09-25 (branch rehearsal-e2b).

VLLM_VERSION=0.30.0

MODEL_REPO=google/gemma-4-E2B-it
MODEL_REVISION=3e22461f65e89153144f8adb70e3b8c2cc9845a7
MODEL_FILES=model.safetensors:2db5482b20d746879bb3ef79b5203e9075a2e2b98f54ec7c2f281c1477ddc550,config.json:1b28f3d2c3100f6c594754b81107428bd7b822a7f48272ca681dae9d2ec38330,generation_config.json:d4226bbe3117d2d253ba4609720ba82c6c4ce4627a9a6ae05387c78983ac03de

TOKENIZER_REPO=google/gemma-4-E2B-it
TOKENIZER_REVISION=3e22461f65e89153144f8adb70e3b8c2cc9845a7
TOKENIZER_FILES=chat_template.jinja:0a2c8073c878ab1da004bee933a998606537bbb62016310352c7285c3f01c5b5,tokenizer.json:cc8d3a0ce36466ccc1278bf987df5f71db1719b9ca6b4118264f45cb627bfe0f,tokenizer_config.json:9f4fec4b1dc6ecddf8f4a92e9caea5971c0e67d81309f3f9066a2bee8c362633,config.json:1b28f3d2c3100f6c594754b81107428bd7b822a7f48272ca681dae9d2ec38330,generation_config.json:d4226bbe3117d2d253ba4609720ba82c6c4ce4627a9a6ae05387c78983ac03de,processor_config.json:32bdf45d2ad4cc29a0822ddd157a182de76644f0419a6228d151495256e9813c

MODEL_ALIAS=gemma-4-e2b-it
CONTEXT_TOKENS=65536
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=fp8
KV_OFFLOADING_GIB=0
MTP_SPECULATIVE_TOKENS=3
DRAFTER_REPO=google/gemma-4-E2B-it-assistant
DRAFTER_REVISION=2d874ef7d29f9a30599a1e4b3c1cbc9595f005df
DRAFTER_FILES=model.safetensors:93682eb1c97639d18f007704dc880bd74cbe530adaf7b1bb561213863fdad2a6,config.json:7f42f559a6a69ffaeaf6b61a1ece3a562a2ed5ad00b8d30f16917ba5ab1bcbe9,generation_config.json:8e58004dc0e2407b63410b190bb8470efbdcfeb71533f1770e09c20abe193a6f
LOAD_DEADLINE_S=900

PUBLIC_PORT=8090
CONTROL_PORT=8091
ENGINE_PORT=8092
