# The card's pins and parameters (contract section 12), read by card/bootstrap.sh and simple_serving/card.py. No
# credentials, no quotes and no spaces. A change makes the card unprepared until bootstrap.sh runs again.

# Empty until the pin is chosen (section 15, before the rental). While it is empty, bootstrap.sh refuses.
VLLM_VERSION=

# The weights: the file that simple-story-chat serves with llama.cpp (its gpu/manifest.env).
MODEL_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic-GGUF
MODEL_REVISION=eee61b81461ac75eb920a24ca9e5d420bb66e33d
MODEL_FILE=gemma-4-31B-it-uncensored-heretic-Q6_K.gguf
MODEL_SHA256=ec331ca8d40bef30bc00312b506a78e01bd9bdc6aa98d449d79b2942eca6efc1

# The base model's tokenizer and chat template at one revision, each file as name:sha256, separated by commas. Empty
# until the pin.
TOKENIZER_REPO=
TOKENIZER_REVISION=
TOKENIZER_FILES=

# What vLLM serves. The memory values are provisional until the smoke (section 15, step 1).
MODEL_ALIAS=gemma-4-31b-heretic-q6k
CONTEXT_TOKENS=65536
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=auto
# Seconds from the start of the pair to the gateway's first ready, fixed before the load is measured. Provisional.
LOAD_DEADLINE_S=900

# The listeners, all on loopback: the gateway's public and control listeners, and vLLM.
PUBLIC_PORT=8090
CONTROL_PORT=8091
ENGINE_PORT=8092
