# The card's pins and parameters (contract section 12), read by card/bootstrap.sh and simple_serving/card.py. No
# credentials, no quotes and no spaces. A change makes the card unprepared until bootstrap.sh runs again.

# vLLM's release of 2026-09-22. bootstrap.sh refuses until card/vllm-requirements.txt locks it.
VLLM_VERSION=0.30.0

# The weights, route A of section 15: a 4-bit NVFP4 conversion of the heretic, whose Q6_K GGUF simple-story-chat serves
# with llama.cpp. vLLM loads it in tree. Each file as name:sha256, separated by commas. bootstrap.sh fetches them into
# models/<MODEL_REVISION>, which holds nothing else, since vLLM loads every *.safetensors it finds there. config.json
# carries the quantization, and generation_config.json the stop ids. MODEL_REPO and TOKENIZER_REPO alone name the
# sources on the Hugging Face hub, so a mirror there is a change of this file.
MODEL_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic-NVFP4
MODEL_REVISION=24ac337ecd25c89d9211d40139696dae84591f1f
MODEL_FILES=model-00001-of-00003.safetensors:b147cb14e0620a5679f959baf5a11ec4572e7ca5351f88d72e4b59793dcd2c52,model-00002-of-00003.safetensors:bb6b0aaa01507d8636a81a15e681c922d8ecce6dd93e88f3bbb09a0e5a6c9876,model-00003-of-00003.safetensors:d52f3ed16b7934dccf217039dd9923ec12e6db3c7ed9bbd64334f99a009e0e4d,config.json:b2b22f689a16f2d6344bc3ffb5e97f296ca4676f244cfcdbaaf56de59aea601f,generation_config.json:857bd7826fd84d2522f7bd1d07d9b42bba84b715718984e931bc6d46b01c226c

# The heretic's tokenizer and chat template, at the revision whose template llama.cpp uses too (simple-story-chat's
# GEMMA_TEMPLATE_SHA256), each file as name:sha256, separated by commas. vLLM takes the template from here; the one in
# the weights' repository differs and is not fetched.
TOKENIZER_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic
TOKENIZER_REVISION=76ac65c75ce10fb7b570e7f98acd385527e7095c
TOKENIZER_FILES=chat_template.jinja:0a52be69cda5ab8aeb627d6ff51a7b34c7d06afabb6b0f00cf8ee63df16a6315,tokenizer.json:a2619fe11b50dbed06ac443c51d757b354d0b62d64baa514404d4e84e6713519,tokenizer_config.json:90c3a3ba5bf53818383a58e1a776cbcacd2a038d4812eaa373e1522f2d06f3df,config.json:b5d56c2687a89adc5a485aa25e05269cd2c12472b4cfa129604656db29f5665f,generation_config.json:857bd7826fd84d2522f7bd1d07d9b42bba84b715718984e931bc6d46b01c226c,processor_config.json:32bdf45d2ad4cc29a0822ddd157a182de76644f0419a6228d151495256e9813c

# What vLLM serves. The memory values are provisional until the smoke (section 15, step 1).
MODEL_ALIAS=gemma-4-31b-heretic-nvfp4
CONTEXT_TOKENS=65536
MAX_NUM_SEQS=8
# Tokens per step, below vLLM's 2048: a long request then reserves less KV cache, and a step that reads a prompt is
# shorter, so the answers beside it keep streaming. It costs about 0.4 s per prompt of 60k tokens.
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEMORY_UTILIZATION=0.92
# fp8 (e4m3, scale 1.0) holds twice the tokens of auto (bfloat16). int8_per_token_head, the nearest to llama.cpp's
# q8_0 cache, is the one to compare in the smoke.
KV_CACHE_DTYPE=fp8
# Seconds from the start of the pair to the gateway's first ready, fixed before the load is measured. Provisional.
LOAD_DEADLINE_S=900

# The listeners, all on loopback: the gateway's public and control listeners, and vLLM.
PUBLIC_PORT=8090
CONTROL_PORT=8091
ENGINE_PORT=8092
