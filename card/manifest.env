# The card's pins and parameters (contract section 12), read by card/bootstrap.sh and simple_serving/card.py. No
# credentials, no quotes and no spaces. A change makes the card unprepared until bootstrap.sh runs again.

# vLLM's release of 2026-09-22. card/vllm-requirements.txt locks it, and bootstrap.sh refuses a lock of another version.
VLLM_VERSION=0.30.0

# The weights, route A of section 15: a 4-bit NVFP4 conversion of the heretic, whose Q6_K GGUF simple-story-chat serves
# with llama.cpp. vLLM loads it in tree. Each file as name:sha256, separated by commas. bootstrap.sh fetches them into
# models/<MODEL_REVISION> and removes any other file there that is not hidden, since vLLM loads every *.safetensors
# it finds there. config.json carries the quantization, and generation_config.json the stop ids. MODEL_REPO and
# TOKENIZER_REPO alone name the sources on the Hugging Face hub, so a mirror there is a change of this file.
MODEL_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic-NVFP4
MODEL_REVISION=24ac337ecd25c89d9211d40139696dae84591f1f
MODEL_FILES=model-00001-of-00003.safetensors:b147cb14e0620a5679f959baf5a11ec4572e7ca5351f88d72e4b59793dcd2c52,model-00002-of-00003.safetensors:bb6b0aaa01507d8636a81a15e681c922d8ecce6dd93e88f3bbb09a0e5a6c9876,model-00003-of-00003.safetensors:d52f3ed16b7934dccf217039dd9923ec12e6db3c7ed9bbd64334f99a009e0e4d,config.json:b2b22f689a16f2d6344bc3ffb5e97f296ca4676f244cfcdbaaf56de59aea601f,generation_config.json:857bd7826fd84d2522f7bd1d07d9b42bba84b715718984e931bc6d46b01c226c

# The heretic's tokenizer and chat template, at the revision whose template llama.cpp uses too (simple-story-chat's
# GEMMA_TEMPLATE_SHA256), each file as name:sha256, separated by commas. vLLM takes the template from here; the one in
# the weights' repository differs and is not fetched.
TOKENIZER_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic
TOKENIZER_REVISION=76ac65c75ce10fb7b570e7f98acd385527e7095c
TOKENIZER_FILES=chat_template.jinja:0a52be69cda5ab8aeb627d6ff51a7b34c7d06afabb6b0f00cf8ee63df16a6315,tokenizer.json:a2619fe11b50dbed06ac443c51d757b354d0b62d64baa514404d4e84e6713519,tokenizer_config.json:90c3a3ba5bf53818383a58e1a776cbcacd2a038d4812eaa373e1522f2d06f3df,config.json:b5d56c2687a89adc5a485aa25e05269cd2c12472b4cfa129604656db29f5665f,generation_config.json:857bd7826fd84d2522f7bd1d07d9b42bba84b715718984e931bc6d46b01c226c,processor_config.json:32bdf45d2ad4cc29a0822ddd157a182de76644f0419a6228d151495256e9813c

# What vLLM serves. The memory values are provisional until the smoke (section 15, step 1).
MODEL_ALIAS=gemma-4-31b-heretic-nvfp4
CONTEXT_TOKENS=65536
MAX_NUM_SEQS=8
# Tokens per step, below vLLM's 2048: a long request then reserves less KV cache, and a step that reads a prompt is
# shorter, so the answers beside it keep streaming. A long prompt then takes about twice as many steps to read, at a
# cost not measured yet (section 15, step 4).
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEMORY_UTILIZATION=0.92
# fp8 (e4m3, scale 1.0) holds twice the tokens of auto (bfloat16). int8_per_token_head, the nearest to llama.cpp's
# q8_0 cache, is the one to compare in the smoke.
KV_CACHE_DTYPE=fp8
# GiB of the card's RAM that keep a copy of the KV cache, vLLM's native offloading: a prefix the cache on the GPU has
# dropped loads back from there instead of being read again. The copies keep the GPU's block hashes, a reader's cache
# salt among them, so no reader loads another's. The buffer is one file in /dev/shm, resident whole from the start: it
# has to fit that mount's free space, and the container's memory beside the engine. bootstrap.sh refuses a size that
# does not, before it installs or fetches anything (exit 9), and the launcher gives up before it loads
# (simple_serving/preflight.py). A size at or below the GPU's own cache, about 9 GiB, adds nothing; docs/speed.md,
# item 5, has what a session takes. 0 is off, the default until a rental measures it. The owner asked for it on
# 2026-09-27.
KV_OFFLOADING_GIB=0
# Pictures, so that captions of pose references are written here and the pictures never go to a hosted API, as the
# owner wants since 2026-09-28: 1 loads Gemma 4's vision tower, which vLLM keeps off the GPU otherwise, and the client
# key may send one picture a request, a data URL of PNG, JPEG or WebP (contract section 4). The tower's 0.58 billion
# parameters stay in bfloat16, 1.07 GiB that come out of the KV cache, and its encoder's working memory with them; a
# rental measures what is left. vLLM 0.30.0 builds the picture processor from the weights' directory, so bootstrap.sh
# copies the tokenizer's processor_config.json, tokenizer.json and tokenizer_config.json there, checked against their
# pins above, and removes them at 0. Multi-token prediction stays as it is: the drafter drafts from the text alone.
# 0 is off, the default until a rental measures it.
VISION=0
# Speculative decoding with Gemma 4's multi-token prediction, vLLM's method mtp: Google's assistant for the 31B drafts
# this many tokens a step on the heretic's KV cache, and the heretic verifies each, so only the speed changes. With 3
# it more than doubled route A's decoding on a 5090 on 2026-09-26, and the owner kept it on (the contract's Decided).
# 0 turns it off: bootstrap.sh fetches no drafter, and vLLM gets no --speculative-config. The drafter's files, each as
# name:sha256, separated by commas, go into drafters/<DRAFTER_REVISION>, where a file that is not pinned goes, as in
# the weights' directory. vLLM 0.30.0 reads config.json, generation_config.json and the *.safetensors there; the
# tokenizer stays the heretic's.
MTP_SPECULATIVE_TOKENS=3
DRAFTER_REPO=google/gemma-4-31B-it-assistant
DRAFTER_REVISION=627c5ec1458b9086b841a91e0512fd31fd2fbbf1
DRAFTER_FILES=model.safetensors:9f80df6099fa1fd7db71220ec9ee864d5ecff769878697dd5763e4285b15a1da,config.json:d09487c1083a334a97545f204dd41ab1a40b0438bdead19558f0e1357e26d66a,generation_config.json:8e58004dc0e2407b63410b190bb8470efbdcfeb71533f1770e09c20abe193a6f
# 1 pins Gemma 4's reasoning markers and permits per-request thinking_token_budget at the text gateway.
# 0 refuses that field before any engine call. Keep 0 until a GPU check validates Gemma 4 with MTP;
# upstream examples for other models do not verify this path. See docs/thinking-budget.md.
THINKING_BUDGET=0
# The model's profile: gemma serves the pins above; qwen serves the QWEN_ pins below instead, each standing for the
# value of the same name without the prefix (docs/qwen.md). Any other word is refused. gemma is the default until a
# rental measures the other, which the owner asked to have ready on 2026-10-07.
MODEL_PROFILE=gemma
# Qwen3.8-27B, abliterated by huihui-ai, in NVFP4 (W4A4) by llm-compressor, with its multi-token prediction layer in
# bfloat16 in a file of its own. vLLM 0.30.0 loads the architecture in tree (Qwen3_5ForConditionalGeneration); the
# repository holds no Python file, and nothing runs with --trust-remote-code. Files as above, name:sha256, and their
# sizes as name:bytes, which bootstrap.sh holds against the free disk before it fetches. The tokenizer and the chat
# template come from the same repository at the same revision, into tokenizers/<revision>.
QWEN_MODEL_REPO=sakamakismile/Huihui-Qwen3.8-27B-abliterated-NVFP4
QWEN_MODEL_REVISION=36276309d30211d9babf72f22d1605dc2dc6357c
QWEN_MODEL_FILES=model.safetensors:cb595ed2770d612737c1114dcdc79c191925eacafdf0b5c90ecdc4cf982ae058,model-mtp-bf16.safetensors:90fa0e3eed5a647c035c6df9ecabc416c0f8d573ff84ac12485b085f00a7cdf2,config.json:783a7999e813d3388e93bbe9ac865a62ed729196b40b07fa2b3c32258f8aaea1,generation_config.json:069f479d9098b15e9246a782bfa0dedf8bc38d8153233d8215e4e16839fd2908
QWEN_MODEL_SIZES=model.safetensors:19709883808,model-mtp-bf16.safetensors:849400424,config.json:15632,generation_config.json:225
QWEN_TOKENIZER_REPO=sakamakismile/Huihui-Qwen3.8-27B-abliterated-NVFP4
QWEN_TOKENIZER_REVISION=36276309d30211d9babf72f22d1605dc2dc6357c
QWEN_TOKENIZER_FILES=chat_template.jinja:c3cf9e34abf4f9e36c2d72165aa9c132d3e2a725b6c2586aaa3a8af9d7a81041,tokenizer.json:06b9509352d2af50381ab2247e083b80d32d5c0aba91c272ca9ff729b6a0e523,tokenizer_config.json:792fa3f0cb88b111e54ef3134c873531008c4df471d108da17903426e308aa7b,vocab.json:ce99b4cb2983d118806ce0a8b777a35b093e2000a503ebde25853284c9dfa003,merges.txt:a9d356d7bdf1ef4949e3e748e95b8e10ad9d4e2e838eddc38a0a7b6b94d1db8d
QWEN_MODEL_ALIAS=qwen3.8-27b-abliterated-nvfp4
# The model's own limit is 262144 (max_position_embeddings); 32768 is what its card measured.
QWEN_CONTEXT_TOKENS=32768
# Tokens its own layer drafts a step, 0 for none. Its card measured 3.
QWEN_MTP_SPECULATIVE_TOKENS=3
# Tokens between the places where a prefix hit may land, a divisor of the model's cache block; 0 leaves vLLM's
# default, the block itself, about 1600 tokens (docs/qwen.md). Not measured.
QWEN_PREFIX_MATCH_UNIT=0
# The card these weights need, which bootstrap.sh checks before it fetches them: a compute capability of 12.0, as 120
# (Blackwell, for vLLM's W4A4 kernels; an older card would take a weight-only fallback), and MiB of memory.
QWEN_MIN_COMPUTE_CAP=120
QWEN_MIN_GPU_MIB=30000
# MODEL_PROFILE=small: Google's Gemma 4 E2B in bfloat16 with its assistant as the drafter, 10.2 GB, for a Blackwell
# card of 16 GB on which the service's mechanisms are tried before the 5090 (docs/cheap-card.md). The pins are those
# of the rehearsal of 2026-09-25 and the cheap card of 2026-09-27; the profile is text only, so the picture
# processor's files are not among the tokenizer's. Its context is 16384 tokens, which the measurement's requests fit.
SMALL_MODEL_REPO=google/gemma-4-E2B-it
SMALL_MODEL_REVISION=3e22461f65e89153144f8adb70e3b8c2cc9845a7
SMALL_MODEL_FILES=model.safetensors:2db5482b20d746879bb3ef79b5203e9075a2e2b98f54ec7c2f281c1477ddc550,config.json:1b28f3d2c3100f6c594754b81107428bd7b822a7f48272ca681dae9d2ec38330,generation_config.json:d4226bbe3117d2d253ba4609720ba82c6c4ce4627a9a6ae05387c78983ac03de
SMALL_TOKENIZER_REPO=google/gemma-4-E2B-it
SMALL_TOKENIZER_REVISION=3e22461f65e89153144f8adb70e3b8c2cc9845a7
SMALL_TOKENIZER_FILES=chat_template.jinja:0a2c8073c878ab1da004bee933a998606537bbb62016310352c7285c3f01c5b5,tokenizer.json:cc8d3a0ce36466ccc1278bf987df5f71db1719b9ca6b4118264f45cb627bfe0f,tokenizer_config.json:9f4fec4b1dc6ecddf8f4a92e9caea5971c0e67d81309f3f9066a2bee8c362633
SMALL_MODEL_ALIAS=gemma-4-e2b-it
SMALL_DRAFTER_REPO=google/gemma-4-E2B-it-assistant
SMALL_DRAFTER_REVISION=2d874ef7d29f9a30599a1e4b3c1cbc9595f005df
SMALL_DRAFTER_FILES=model.safetensors:93682eb1c97639d18f007704dc880bd74cbe530adaf7b1bb561213863fdad2a6,config.json:7f42f559a6a69ffaeaf6b61a1ece3a562a2ed5ad00b8d30f16917ba5ab1bcbe9,generation_config.json:8e58004dc0e2407b63410b190bb8470efbdcfeb71533f1770e09c20abe193a6f
SMALL_CONTEXT_TOKENS=16384
SMALL_MTP_SPECULATIVE_TOKENS=3
# MiB of KV cache on the GPU, in place of the size vLLM takes from GPU_MEMORY_UTILIZATION; 0 leaves vLLM's own. Only
# a measurement sets it, to make the cache small on purpose.
KV_CACHE_MEMORY_MIB=0
# Generations at once over all classes and for each of reader, agent and internal, in place of the contract's
# provisional limits (4 over all); 0 leaves those. At most MAX_NUM_SEQS. Only a measurement sets it.
GENERATIONS_AT_ONCE=0
# Seconds from the start of the pair to the gateway's first ready, fixed before the load is measured. Provisional.
LOAD_DEADLINE_S=900

# The listeners, all on loopback: the gateway's public and control listeners, and vLLM.
PUBLIC_PORT=8090
CONTROL_PORT=8091
ENGINE_PORT=8092
