{
  "contract": "1",
  "about": "Shared cases of contract v1 (docs/contract-v1.md). The gateway's tests play the engine part through the fake engine and check the response; a client's tests play the response and check the result. Format: contract/README.md.",
  "service": {
    "alias": "test-model",
    "context_tokens": 4096,
    "body_limit_bytes": 2000000,
    "keys": {
      "test-key-bot": { "label": "bot", "classes": ["reader", "agent", "internal"], "default": "internal", "scopes": true, "control": false },
      "test-key-control": { "label": "control", "classes": [], "default": null, "scopes": false, "control": true },
      "test-key-outside-a": { "label": "outside-a", "classes": ["external"], "default": "external", "scopes": false, "control": false },
      "test-key-outside-b": { "label": "outside-b", "classes": ["external"], "default": "external", "scopes": false, "control": false }
    },
    "limits": {
      "reader": { "active": 4, "waiting": 8, "input_tokens": null, "max_tokens": 1024, "wall_s": 300 },
      "agent": { "active": 1, "waiting": 2, "input_tokens": null, "max_tokens": 1024, "wall_s": 900 },
      "internal": { "active": 2, "waiting": 8, "input_tokens": null, "max_tokens": 1024, "wall_s": 900 },
      "external": { "active": 2, "waiting": 4, "input_tokens": 1024, "max_tokens": 256, "wall_s": 120 },
      "external_per_key": { "active": 1, "waiting": 2 },
      "shared": { "active": 3 }
    },
    "count_limits": { "active": 3, "per_outside_key": 2 },
    "engine_priority": { "reader": 0, "agent": 1, "internal": 2, "external": 3 },
    "drain_deadline_s": 60
  },
  "defaults": {
    "chat_body": {
      "model": "test-model",
      "messages": [
        { "role": "system", "content": "You narrate a short synthetic story." },
        { "role": "user", "content": "The lighthouse keeper opens the door." }
      ],
      "max_tokens": 64,
      "stream": true,
      "stream_options": { "include_usage": true }
    }
  },
  "cases": [
    {
      "name": "stream-basic",
      "about": "A reader's turn streams text, ends with stop and reports usage with cached tokens.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "role": "assistant" }, { "content": "The door " }, { "content": "creaks." }, { "finish_reason": "stop" } ],
            "usage": { "completion_tokens": 3, "cached_tokens": 640 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "role": "assistant" } } ] },
            { "choices": [ { "index": 0, "delta": { "content": "The door " } } ] },
            { "choices": [ { "index": 0, "delta": { "content": "creaks." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 3, "prompt_tokens_details": { "cached_tokens": 640 }, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "The door creaks.", "finish_reason": "stop", "usage": { "input": 812, "output": 3, "cached": 640 } }
        }
      ]
    },
    {
      "name": "stream-length",
      "about": "An answer cut by max_tokens ends with length; content and finish may share a chunk.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "internal" }, "body_patch": { "max_tokens": 2 } },
          "engine": { "input_tokens": 812, "events": [ { "content": "The door", "finish_reason": "length" } ], "usage": { "completion_tokens": 2 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 2, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "The door" }, "finish_reason": "length" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 2, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "The door", "finish_reason": "length", "usage": { "input": 812, "output": 2, "cached": null } }
        }
      ]
    },
    {
      "name": "stream-reasoning",
      "about": "Reasoning from the engine arrives as reasoning_content and is not part of the text.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "agent", "X-Simple-Serving-Scope": "agent" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "reasoning": "The keeper is tired." }, { "content": "He sighs." }, { "finish_reason": "stop" } ],
            "usage": { "completion_tokens": 9 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 1, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "reasoning_content": "The keeper is tired." } } ] },
            { "choices": [ { "index": 0, "delta": { "content": "He sighs." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 9, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "He sighs.", "reasoning": "The keeper is tired.", "finish_reason": "stop", "usage": { "input": 812, "output": 9, "cached": null } }
        }
      ]
    },
    {
      "name": "stream-empty-deltas",
      "about": "Empty and role-only deltas are allowed and add nothing to the text.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "role": "assistant" }, {}, { "content": "Wind." }, {}, { "finish_reason": "stop" } ],
            "usage": { "completion_tokens": 2 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "role": "assistant" } } ] },
            { "choices": [ { "index": 0, "delta": {} } ] },
            { "choices": [ { "index": 0, "delta": { "content": "Wind." } } ] },
            { "choices": [ { "index": 0, "delta": {} } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 2, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "Wind.", "finish_reason": "stop", "usage": { "input": 812, "output": 2, "cached": null } }
        }
      ]
    },
    {
      "name": "json-schema",
      "about": "A structured answer is requested with json_schema and arrives as text.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" },
            "body_patch": { "temperature": 0.2, "response_format": { "type": "json_schema", "json_schema": { "name": "reply", "strict": true,
              "schema": { "type": "object", "properties": { "place": { "type": "string" } }, "required": ["place"], "additionalProperties": false } } } } },
          "engine": { "input_tokens": 830, "events": [ { "content": "{\"place\": \"lighthouse\"}" }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 7 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": "present", "response_format": "json_schema" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "{\"place\": \"lighthouse\"}" } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 830, "completion_tokens": 7, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "{\"place\": \"lighthouse\"}", "finish_reason": "stop", "usage": { "input": 830, "output": 7, "cached": null } }
        }
      ]
    },
    {
      "name": "count",
      "about": "Counting the body of stream-basic gives the prompt_tokens its generation reports.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions/input_tokens", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": { "input_tokens": 812 },
          "engine_receives": { "calls": ["tokenize"] },
          "response": { "status": 200, "json": { "input_tokens": 812 } },
          "result": { "input_tokens": 812 }
        }
      ]
    },
    {
      "name": "count-over-limits",
      "about": "Counting applies neither the class limits nor the context: the answer is the count.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions/input_tokens", "key": "test-key-outside-a", "body_patch": { "max_tokens": 512 } },
          "engine": { "input_tokens": 5000 },
          "engine_receives": { "calls": ["tokenize"] },
          "response": { "status": 200, "json": { "input_tokens": 5000 } },
          "result": { "input_tokens": 5000 }
        }
      ]
    },
    {
      "name": "default-class",
      "about": "Without a class header the key's default class applies, with its engine priority and scope.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot", "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "H." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 2, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "H." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "H.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        }
      ]
    },
    {
      "name": "models",
      "about": "One model, the alias, with the effective context.",
      "steps": [
        {
          "request": { "base": "public", "method": "GET", "path": "/v1/models", "key": "test-key-outside-a" },
          "engine": null,
          "response": { "status": 200, "json": { "object": "list", "data": [ { "id": "test-model", "object": "model", "max_model_len": 4096 } ] } },
          "result": { "model": "test-model", "context_tokens": 4096 }
        }
      ]
    },
    {
      "name": "state",
      "about": "Any key reads the state; the control key also sees counts and versions.",
      "steps": [
        {
          "request": { "base": "public", "method": "GET", "path": "/v1/state", "key": "test-key-bot" },
          "engine": null,
          "response": { "status": 200, "json": { "contract": "1", "boot_id": "present", "status": "ready", "model": "test-model", "context_tokens": 4096, "drain_generation": 0 } },
          "result": { "status": "ready" }
        },
        {
          "request": { "base": "control", "method": "GET", "path": "/v1/state", "key": "test-key-control" },
          "engine": null,
          "response": { "status": 200, "json": { "contract": "1", "boot_id": "present", "status": "ready", "model": "test-model", "context_tokens": 4096, "drain_generation": 0,
            "active": { "reader": 0, "agent": 0, "internal": 0, "external": 0 }, "waiting": { "reader": 0, "agent": 0, "internal": 0, "external": 0 }, "versions": "present" } },
          "result": { "status": "ready" }
        }
      ]
    },
    {
      "name": "no-key",
      "about": "A request without a key is refused.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": null, "body_patch": {} },
          "engine": null,
          "response": { "status": 401, "error": "unauthorized" },
          "result": { "error": "unauthorized" }
        }
      ]
    },
    {
      "name": "unknown-key",
      "about": "A key the gateway does not know is refused.",
      "steps": [
        {
          "request": { "base": "public", "method": "GET", "path": "/v1/state", "key": "test-key-unknown" },
          "engine": null,
          "response": { "status": 401, "error": "unauthorized" },
          "result": { "error": "unauthorized" }
        }
      ]
    },
    {
      "name": "class-not-allowed",
      "about": "An outside key cannot ask for the reader class.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-outside-a",
            "headers": { "X-Simple-Serving-Class": "reader" }, "body_patch": {} },
          "engine": null,
          "response": { "status": 403, "error": "class_not_allowed" },
          "result": { "error": "class_not_allowed" }
        }
      ]
    },
    {
      "name": "scope-not-allowed",
      "about": "An outside key cannot name a cache scope.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-outside-a",
            "headers": { "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": null,
          "response": { "status": 403, "error": "scope_not_allowed" },
          "result": { "error": "scope_not_allowed" }
        }
      ]
    },
    {
      "name": "reader-needs-scope",
      "about": "A reader request without a reader scope is refused, so readers never share a cache by accident.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader" }, "body_patch": {} },
          "engine": null,
          "response": { "status": 400, "error": "invalid_request" },
          "result": { "error": "invalid_request" }
        },
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "agent" }, "body_patch": {} },
          "engine": null,
          "response": { "status": 400, "error": "invalid_request" },
          "result": { "error": "invalid_request" }
        }
      ]
    },
    {
      "name": "cache-scopes",
      "about": "One scope keeps one salt; different scopes and different outside keys get different salts.",
      "steps": [
        {
          "name": "r1-first",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "A." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": "present" },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "A." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "A.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        },
        {
          "name": "r1-again",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r1aaaaaa" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "B." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": { "same_as": "r1-first" } },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "B." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "B.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        },
        {
          "name": "r2",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "reader", "X-Simple-Serving-Scope": "reader.r2bbbbbb" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "C." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 0, "cache_salt": { "differs_from": ["r1-first"] } },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "C." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "C.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        },
        {
          "name": "internal",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot",
            "headers": { "X-Simple-Serving-Class": "internal" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "D." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 2, "cache_salt": { "differs_from": ["r1-first", "r2"] } },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "D." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "D.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        },
        {
          "name": "outside-a",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-outside-a", "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "E." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 3, "cache_salt": { "differs_from": ["r1-first", "r2", "internal"] } },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "E." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "E.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        },
        {
          "name": "outside-b",
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-outside-b", "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "F." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 3, "cache_salt": { "differs_from": ["r1-first", "r2", "internal", "outside-a"] } },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "F." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "F.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        }
      ]
    },
    {
      "name": "engine-priority-from-client-is-ignored",
      "about": "An engine priority header from a client never reaches the engine; the class decides.",
      "steps": [
        {
          "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-outside-a",
            "headers": { "X-Vllm-Priority": "0" }, "body_patch": {} },
          "engine": { "input_tokens": 812, "events": [ { "content": "G." }, { "finish_reason": "stop" } ], "usage": { "completion_tokens": 1 } },
          "engine_receives": { "calls": ["tokenize", "generate"], "priority": 3, "cache_salt": "present", "headers_absent": ["x-vllm-priority"] },
          "response": { "status": 200, "done": true, "chunks": [
            { "choices": [ { "index": 0, "delta": { "content": "G." } } ] },
            { "choices": [ { "index": 0, "delta": {}, "finish_reason": "stop" } ] },
            { "choices": [], "usage": { "prompt_tokens": 812, "completion_tokens": 1, "simple_serving": "measurements" } }
          ] },
          "result": { "text": "G.", "finish_reason": "stop", "usage": { "input": 812, "output": 1, "cached": null } }
        }
      ]
    },
    {
      "name": "unsupported-fields",
      "about": "Fields outside the contract are refused, at any depth, including engine priority and cache salt.",
      "steps": [
        { "request": { "base": "public", "method": "POST", "path": "/v1/chat/completions", "key": "test-key-bot", "headers": { "X-Simple-Serving-Class": "internal" }, "body_patch": { "tools": [] } },
